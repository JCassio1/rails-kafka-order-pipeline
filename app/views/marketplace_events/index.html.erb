<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700;800&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
  <style>
    .pipeline-dashboard {
      --ink-1: #4f241b;
      --ink-2: #72493e;
      --ink-3: #8f5f52;
      --accent: #b14434;
      --line: rgba(119, 74, 61, 0.26);
      --panel-bg: linear-gradient(160deg, rgba(255, 255, 255, 0.78), rgba(255, 245, 239, 0.66));
      position: fixed;
      inset: 0;
      z-index: 40;
      overflow: hidden;
      padding: 12px;
      font-family: "DM Sans", sans-serif;
      background:
        radial-gradient(1000px 500px at -12% -8%, rgba(177, 68, 52, 0.22), transparent 56%),
        radial-gradient(750px 420px at 112% 102%, rgba(204, 134, 100, 0.26), transparent 54%),
        linear-gradient(150deg, #f4e6dc 0%, #ecd5c5 45%, #e5c2ac 100%);
    }

    .dashboard-shell {
      height: 100%;
      width: 100%;
      display: grid;
      grid-template-rows: auto auto minmax(0, 1fr);
      gap: 10px;
    }

    .dashboard-title {
      margin: 0;
      font-family: "Space Grotesk", sans-serif;
      font-size: clamp(1.7rem, 2vw, 2.45rem);
      line-height: 1.08;
      color: var(--ink-1);
    }

    .dashboard-header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 16px;
    }

    .dashboard-header p {
      margin: 0;
      color: var(--ink-2);
    }

    .subtitle {
      margin-top: 6px;
      font-size: 0.95rem;
    }

    .panel {
      background: var(--panel-bg);
      border: 1px solid var(--line);
      border-radius: 14px;
      box-shadow: 0 10px 24px rgba(92, 46, 35, 0.14);
      backdrop-filter: blur(7px);
      min-height: 0;
    }

    .update-pill {
      min-width: 205px;
      padding: 10px 12px;
      text-align: right;
      color: var(--ink-1);
      font-size: 0.92rem;
    }

    .update-pill span {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--ink-3);
      display: block;
      margin-bottom: 2px;
    }

    .counter-grid {
      display: grid;
      gap: 10px;
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .counter-card {
      padding: 10px 14px;
      background: linear-gradient(180deg, rgba(255, 237, 227, 0.96), rgba(247, 219, 203, 0.84));
      border: 1px solid rgba(143, 89, 75, 0.28);
      border-radius: 12px;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.45);
    }

    .counter-label {
      margin: 0;
      font-size: 0.76rem;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: #8d5142;
    }

    .counter-value {
      margin: 4px 0 0;
      color: #7b2d22;
      font-size: clamp(1.65rem, 2.1vw, 2.2rem);
      font-weight: 800;
      line-height: 1;
    }

    .dashboard-grid {
      display: grid;
      gap: 10px;
      min-height: 0;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: minmax(0, 0.96fr) minmax(0, 1fr) minmax(0, 0.58fr);
      grid-template-areas:
        "orders orders orders orders orders orders orders feed feed feed feed feed"
        "recent recent recent recent recent recent recent feed feed feed feed feed"
        "distribution distribution distribution distribution activity activity activity activity activity activity activity activity";
    }

    .orders-panel { grid-area: orders; }
    .feed-panel { grid-area: feed; }
    .recent-panel { grid-area: recent; }
    .distribution-panel { grid-area: distribution; }
    .activity-panel { grid-area: activity; }

    .panel-inner {
      display: flex;
      flex-direction: column;
      min-height: 0;
      height: 100%;
      padding: 12px;
    }

    .panel-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 10px;
    }

    .panel-title {
      margin: 0;
      font-family: "Space Grotesk", sans-serif;
      color: #5b281f;
      font-size: 1.22rem;
      line-height: 1.15;
    }

    .live-badge {
      padding: 3px 9px;
      border-radius: 999px;
      background: rgba(177, 68, 52, 0.11);
      color: #a3392b;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .kpi-row {
      display: flex;
      gap: 8px;
      margin-left: auto;
    }

    .kpi {
      min-width: 108px;
      padding: 7px 9px;
      border-radius: 10px;
      background: linear-gradient(180deg, rgba(255, 237, 227, 0.96), rgba(247, 219, 203, 0.84));
      border: 1px solid rgba(143, 89, 75, 0.3);
    }

    .kpi-label {
      margin: 0;
      font-size: 0.63rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: #8d5142;
    }

    .kpi-value {
      margin: 2px 0 0;
      color: #7b2d22;
      font-size: 1.2rem;
      font-weight: 800;
      line-height: 1.1;
    }

    .panel-body {
      min-height: 0;
      flex: 1;
    }

    .feed-list {
      list-style: none;
      margin: 0;
      padding: 0;
      overflow-y: auto;
      display: grid;
      gap: 8px;
      height: 100%;
    }

    .feed-item {
      border: 1px solid rgba(159, 102, 83, 0.34);
      border-radius: 10px;
      padding: 9px 10px;
      background: rgba(255, 248, 243, 0.72);
    }

    .feed-item-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 3px;
    }

    .feed-topic {
      color: #7b2d22;
      font-size: 0.9rem;
      font-weight: 700;
      line-height: 1.2;
    }

    .feed-summary {
      color: #5c4137;
      font-size: 0.88rem;
      line-height: 1.32;
      margin: 0;
    }

    .feed-time {
      color: #8c6658;
      font-size: 0.76rem;
      margin-top: 3px;
      line-height: 1.2;
    }

    .status-pill {
      border-radius: 999px;
      padding: 2px 8px;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .status-pending {
      background: #fef3c7;
      color: #92400e;
    }

    .status-processed {
      background: #dcfce7;
      color: #166534;
    }

    .empty-state {
      color: #7d5b4e;
      margin: 0;
      font-size: 0.95rem;
    }

    .orders-table-wrap {
      height: 100%;
      overflow: auto;
      border-radius: 10px;
      border: 1px solid rgba(159, 102, 83, 0.28);
      background: rgba(255, 249, 244, 0.6);
    }

    .orders-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.85rem;
    }

    .orders-table th {
      position: sticky;
      top: 0;
      z-index: 2;
      text-align: left;
      padding: 8px 10px;
      background: #f2ddd0;
      color: #7a4a3d;
      font-weight: 700;
    }

    .orders-table td {
      padding: 8px 10px;
      color: #5c4137;
      border-top: 1px solid #e6cbbd;
      white-space: nowrap;
    }

    .orders-table td:first-child {
      font-weight: 700;
    }

    .orders-empty {
      text-align: center;
      color: #7d5b4e;
      padding: 16px 10px;
    }

    .activity-grid {
      height: 100%;
      display: grid;
      gap: 8px;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .activity-card {
      border-radius: 10px;
      padding: 10px 12px;
      background: linear-gradient(180deg, rgba(255, 237, 227, 0.96), rgba(247, 219, 203, 0.84));
      border: 1px solid rgba(143, 89, 75, 0.3);
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 0;
    }

    .activity-label {
      margin: 0;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: #8d5142;
    }

    .activity-value {
      margin: 4px 0 0;
      color: #7b2d22;
      font-size: 2rem;
      font-weight: 800;
      line-height: 1;
    }

    .chart-canvas {
      width: 100% !important;
      height: 100% !important;
      display: block;
    }

    @media (max-width: 1300px) {
      .dashboard-grid {
        grid-template-columns: repeat(8, minmax(0, 1fr));
        grid-template-rows: minmax(0, 0.95fr) minmax(0, 1fr) minmax(0, 0.6fr);
        grid-template-areas:
          "orders orders orders orders orders feed feed feed"
          "recent recent recent recent recent feed feed feed"
          "distribution distribution activity activity activity activity activity activity";
      }
    }

    @media (max-width: 1080px) {
      .pipeline-dashboard {
        padding: 10px;
      }

      .dashboard-header {
        align-items: flex-start;
        flex-direction: column;
      }

      .update-pill {
        min-width: 0;
        text-align: left;
      }

      .counter-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .dashboard-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        grid-template-rows: repeat(4, minmax(220px, auto)) minmax(170px, auto);
        grid-template-areas:
          "orders feed"
          "recent feed"
          "recent feed"
          "distribution activity"
          "distribution activity";
        overflow-y: auto;
      }
    }

    @media (max-width: 760px) {
      .counter-grid {
        grid-template-columns: 1fr;
      }

      .dashboard-grid {
        grid-template-columns: 1fr;
        grid-template-rows: repeat(5, minmax(220px, auto));
        grid-template-areas:
          "orders"
          "feed"
          "recent"
          "distribution"
          "activity";
      }

      .activity-grid {
        grid-template-columns: 1fr;
      }

      .kpi-row {
        flex-wrap: wrap;
        justify-content: flex-end;
      }
    }
  </style>
<% end %>

<div
  data-controller="marketplace-dashboard"
  data-marketplace-dashboard-url-value="<%= marketplace_events_path(format: :json) %>"
  data-marketplace-dashboard-interval-value="3000"
  class="pipeline-dashboard"
>
  <div class="dashboard-shell">
    <header class="dashboard-header">
      <div>
        <p style="margin:0;font-size:11px;text-transform:uppercase;letter-spacing:.22em;color:#8d5142;">Marketplace Pipeline</p>
        <h1 class="dashboard-title">Real-Time Event Dashboard</h1>
        <p class="subtitle">Kafka stream visibility across signup, listing, order, and review topics</p>
      </div>
      <div class="panel update-pill">
        <span>Last Updated</span>
        <strong data-marketplace-dashboard-target="updatedAt"><%= Time.current.strftime("%d/%m/%Y, %H:%M:%S") %></strong>
      </div>
    </header>

    <section class="counter-grid" data-marketplace-dashboard-target="counters">
      <% {
        "user.signed_up" => "User Signups",
        "listing.viewed" => "Listing Views",
        "order.placed" => "Orders Placed",
        "review.submitted" => "Reviews Submitted"
      }.each do |topic, label| %>
        <article class="counter-card">
          <p class="counter-label"><%= label %></p>
          <p class="counter-value" data-topic="<%= topic %>"><%= @snapshot[:counters][topic] %></p>
        </article>
      <% end %>
    </section>

    <main class="dashboard-grid">
      <section class="panel orders-panel">
        <div class="panel-inner">
          <div class="panel-header">
            <h2 class="panel-title">Orders Over Time</h2>
            <div class="kpi-row">
              <div class="kpi">
                <p class="kpi-label">Orders</p>
                <p class="kpi-value" data-marketplace-dashboard-target="ordersTotal"><%= @snapshot[:orders_chart][:totals][:orders] %></p>
              </div>
              <div class="kpi">
                <p class="kpi-label">Revenue GBP</p>
                <p class="kpi-value" data-marketplace-dashboard-target="revenueTotal">£<%= format("%.2f", @snapshot[:orders_chart][:totals][:revenue_gbp]) %></p>
              </div>
            </div>
          </div>
          <div class="panel-body">
            <canvas class="chart-canvas" data-marketplace-dashboard-target="ordersChart"></canvas>
          </div>
        </div>
      </section>

      <section class="panel feed-panel">
        <div class="panel-inner">
          <div class="panel-header">
            <h2 class="panel-title">Live Event Feed</h2>
            <span class="live-badge">Live</span>
          </div>
          <ul class="feed-list panel-body" data-marketplace-dashboard-target="feed">
            <% if @snapshot[:feed].empty? %>
              <p class="empty-state">No marketplace events yet.</p>
            <% else %>
              <% @snapshot[:feed].each do |event| %>
                <li class="feed-item">
                  <div class="feed-item-top">
                    <span class="feed-topic"><%= event[:topic] %></span>
                    <span class="status-pill <%= event[:status] == "pending" ? "status-pending" : "status-processed" %>"><%= event[:status] %></span>
                  </div>
                  <p class="feed-summary"><%= event[:payload_summary] %></p>
                  <p class="feed-time"><%= Time.zone.parse(event[:timestamp]).strftime("%d/%m/%Y %H:%M:%S") %></p>
                </li>
              <% end %>
            <% end %>
          </ul>
        </div>
      </section>

      <section class="panel recent-panel">
        <div class="panel-inner">
          <div class="panel-header">
            <h2 class="panel-title">Recent Orders</h2>
          </div>
          <div class="orders-table-wrap panel-body">
            <table class="orders-table">
              <thead>
                <tr>
                  <th>Order ID</th>
                  <th>User ID</th>
                  <th>Amount</th>
                  <th>Currency</th>
                  <th>Status</th>
                  <th>Timestamp</th>
                </tr>
              </thead>
              <tbody data-marketplace-dashboard-target="recentOrders">
                <% if @snapshot[:recent_orders].empty? %>
                  <tr><td class="orders-empty" colspan="6">No recent orders</td></tr>
                <% else %>
                  <% @snapshot[:recent_orders].each do |order| %>
                    <tr>
                      <td><%= order[:order_id] %></td>
                      <td><%= order[:user_id] %></td>
                      <td>£<%= format("%.2f", order[:amount]) %></td>
                      <td><%= order[:currency] %></td>
                      <td><%= order[:status] %></td>
                      <td><%= Time.zone.parse(order[:timestamp]).strftime("%d/%m/%Y %H:%M:%S") %></td>
                    </tr>
                  <% end %>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="panel distribution-panel">
        <div class="panel-inner">
          <div class="panel-header">
            <h2 class="panel-title">Topic Distribution</h2>
          </div>
          <div class="panel-body">
            <canvas class="chart-canvas" data-marketplace-dashboard-target="distributionChart"></canvas>
          </div>
        </div>
      </section>

      <section class="panel activity-panel">
        <div class="panel-inner">
          <div class="panel-header">
            <h2 class="panel-title">User Activity</h2>
          </div>
          <div class="activity-grid panel-body">
            <article class="activity-card">
              <p class="activity-label">Signups (24h)</p>
              <p class="activity-value" data-marketplace-dashboard-target="signups24h"><%= @snapshot[:user_activity][:signups_last_24h] %></p>
            </article>
            <article class="activity-card">
              <p class="activity-label">Total Users</p>
              <p class="activity-value" data-marketplace-dashboard-target="totalUsers"><%= @snapshot[:user_activity][:total_users] %></p>
            </article>
          </div>
        </div>
      </section>
    </main>
  </div>
</div>
